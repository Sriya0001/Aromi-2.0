# AroMi Environment Configuration

# Database Configuration (PostgreSQL for production, fallback SQLite for local dev)
DATABASE_URL=postgresql://postgres:password@localhost:5432/aromi_db
# For SQLite local fallback:
# DATABASE_URL=sqlite:///./aromi.db

# API Keys
GROQ_API_KEY=your_groq_api_key_here
YOUTUBE_API_KEY=your_youtube_api_key_here
SPOONACULAR_API_KEY=your_spoonacular_api_key_here

# Security
SECRET_KEY=your-super-secret-jwt-key-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google OAuth & Calendar
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/calendar/callback

# Frontend URL
FRONTEND_URL=http://localhost:5173
